
//@version=6
// Version: 0.9.0-alpha.1
// Pre-release / unstable. Verification remains incomplete.
// Adds the prop-eval risk governor (50k size, PT 3k, DD 2k, EOD, DLL $300).
// All governor values are REFERENCE accounting seeded at the account size:
// reference equity = account size + cumulative net reference P&L. They are
// never broker P&L and never an order instruction.
// - Daily-loss lockout: day-to-date reference P&L <= -DLL blocks all new
//   candidates for the remainder of the trading day; existing references
//   keep being monitored. Takes precedence over directional quotas.
// - Floor: max(peak EOD reference equity - DD, size - DD); a signal whose
//   reserved risk would breach the floor is blocked.
// - Profit-target progress; optional stop-arming once PT is reached.
// - Reserved-risk budget = min(DLL headroom, floor headroom, budget, clamped
//   to the daily loss limit).
// Adds the outcome ledger, lifecycle alerts and the 1H bias filter (OFF by
// default); per-direction reference concurrency; 5m = chop diagnostics only.
// No broker fills, position tracking or win-rate claims.
// Retains cellText / labelText parameter names.

indicator("CRT Nitro v0.9.0-alpha.1 [Prop-Eval Governor]",
     overlay = true, max_bars_back = 200,
     max_lines_count = 24, max_labels_count = 24)

// ============================================================================
// CHOP AND DASHBOARD INPUTS
// ============================================================================
string GROUP_CHOP = "Chop Calculation"
int lookback = input.int(20, "Lookback candles",
     minval = 10, maxval = 50, group = GROUP_CHOP)
float bodyThreshold = input.float(0.7, "Large body / ATR threshold",
     minval = 0.1, step = 0.1, group = GROUP_CHOP)
float wickThreshold = input.float(0.6, "Combined wicks / range threshold",
     minval = 0.1, maxval = 0.95, step = 0.05, group = GROUP_CHOP)

string GROUP_LOG = "Chop History"
int requestedMinutes = input.int(15, "Requested logging interval — minutes",
     minval = 5, maxval = 240, step = 5, group = GROUP_LOG)
float changeTolerance = input.float(2.0, "Constant-band tolerance — score points",
     minval = 0, step = 0.5, group = GROUP_LOG)
int historyRows = input.int(8, "History rows",
     minval = 3, maxval = 15, group = GROUP_LOG)
string logTimezone = input.string("America/New_York", "Timestamp timezone",
     group = GROUP_LOG)

string GROUP_TABLE = "Dashboard"
string positionInput = input.string("Top Right", "Position",
     options = ["Top Left", "Top Right", "Middle Right",
     "Bottom Left", "Bottom Right"], group = GROUP_TABLE)
string sizeInput = input.string("Small", "Font size",
     options = ["Tiny", "Small", "Normal", "Large"], group = GROUP_TABLE)

